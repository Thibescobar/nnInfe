# ---- builder: install the package + the unified CUDA 12 GPU stack ----
FROM python:3.10-slim AS builder

WORKDIR /app
ENV PIP_NO_CACHE_DIR=1

COPY pyproject.toml README.md ./
COPY nninfe/ nninfe/

# `gpu` extra = onnxruntime-gpu + CUDA 12 / cuDNN 9 wheels + tensorrt-cu12<11 (same as bare metal).
RUN pip install ".[gpu]"

# Drop TensorRT's Windows cross-build builder resources (~3 GB): a Linux image builds and
# runs its engines on Linux and never targets Windows, so these are dead weight. The Linux
# per-arch resources are kept, so the image still works on any NVIDIA GPU.
RUN rm -f /usr/local/lib/python3.10/site-packages/tensorrt_libs/libnvinfer_builder_resource_win_*

# ---- runtime: copy only the installed packages into a clean slim image ----
FROM python:3.10-slim

# libgomp1 is needed by ONNX Runtime; the CUDA/cuDNN/TensorRT userspace libraries come from
# the copied wheels below (the NVIDIA driver's libcuda is injected at `docker run --gpus all`
# by the NVIDIA Container Toolkit).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin/nninfe-det /usr/local/bin/nninfe-seg /usr/local/bin/

# create_session() preloads the CUDA/cuDNN/TensorRT libraries in-process (ORT's preload_dlls()
# for CUDA + cuDNN, and RUNPATH resolution for TensorRT's arch-specific builder-resource libs),
# so no LD_LIBRARY_PATH or activation script is required — verified via `docker run --gpus all`.
CMD ["nninfe-det", "--help"]
