# ---- builder: install + aggressively slim the CUDA 12 GPU stack ----
FROM python:3.10-slim AS builder

# binutils provides `strip` (build-stage only; never reaches the runtime image).
RUN apt-get update && apt-get install -y --no-install-recommends binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PIP_NO_CACHE_DIR=1

COPY pyproject.toml README.md ./
COPY nninfe/ nninfe/

# `gpu` extra = onnxruntime-gpu + CUDA 12 / cuDNN 9 wheels + tensorrt-cu12<11 (same as bare metal).
RUN pip install ".[gpu]"

# Slim the install (see the "Docker images" section in the README):
#  - TensorRT builder resources: keep every Linux GPU architecture by default so a fresh engine
#    can be compiled on any supported GPU. The PTX/JIT resource alone is NOT sufficient for every
#    TensorRT/GPU pair (TensorRT 10.16.1 requires the native sm89 resource on Ada, for example).
#    Set TENSORRT_TARGET_SM=sm89 (or another smNN value) to retain only that architecture and make
#    a smaller, machine-specific image. Windows resources are never useful in this Linux image.
#  - Strip debug symbols; drop headers, static libs, bytecode and type stubs (runtime-useless).
ARG TENSORRT_TARGET_SM=all
RUN set -eux; \
    SP="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    TRT_LIBS="$SP/tensorrt_libs"; \
    rm -f "$TRT_LIBS"/libnvinfer_builder_resource_win_*; \
    case "$TENSORRT_TARGET_SM" in \
      all) ;; \
      sm[0-9][0-9]|sm[0-9][0-9][0-9]) \
        set -- "$TRT_LIBS"/libnvinfer_builder_resource_"$TENSORRT_TARGET_SM".so.*; \
        [ -e "$1" ] || { echo "TensorRT builder resource not found for TENSORRT_TARGET_SM=$TENSORRT_TARGET_SM" >&2; exit 1; }; \
        find "$TRT_LIBS" -maxdepth 1 -type f -name 'libnvinfer_builder_resource_sm*.so*' \
          ! -name "libnvinfer_builder_resource_${TENSORRT_TARGET_SM}.so*" -delete; \
        ;; \
      *) echo "TENSORRT_TARGET_SM must be 'all' or an smNN value (got '$TENSORRT_TARGET_SM')" >&2; exit 1 ;; \
    esac; \
    find "$SP" -name '*.so*' -type f -exec strip --strip-unneeded {} + 2>/dev/null || true; \
    find "$SP" -type d -name include -exec rm -rf {} + 2>/dev/null || true; \
    find "$SP" -name '*.a' -delete; \
    find "$SP" -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true; \
    find "$SP" \( -name '*.pyc' -o -name '*.pyi' \) -delete

# Optional further ~0.8 GB (opt-in, OFF by default): drop cuDNN's precompiled + advanced
# kernels. In the TensorRT path convolutions run *inside* TensorRT, so cuDNN is unused —
# but the `cuda` backend routes convs through the CUDA EP and DOES need them. Enable ONLY
# for TensorRT-only deployments, after validating with your model:
#   docker build --build-arg SLIM_CUDNN=1 -f Dockerfile.trt -t nninfe-trt .
ARG SLIM_CUDNN=0
RUN if [ "$SLIM_CUDNN" = "1" ]; then \
      SP="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
      rm -f "$SP"/nvidia/cudnn/lib/libcudnn_engines_precompiled.so.9 \
            "$SP"/nvidia/cudnn/lib/libcudnn_adv.so.9; \
    fi

# ---- runtime: copy only the slimmed packages into a clean image ----
FROM python:3.10-slim

# libgomp1 is needed by ONNX Runtime; the CUDA/cuDNN/TensorRT userspace libraries come from
# the copied wheels below (the NVIDIA driver's libcuda is injected at `docker run --gpus all`
# by the NVIDIA Container Toolkit).
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin/nninfe-det /usr/local/bin/nninfe-seg /usr/local/bin/

# create_session() preloads the CUDA/cuDNN/TensorRT libraries in-process (ORT's preload_dlls()
# for CUDA + cuDNN, and RUNPATH resolution for TensorRT's builder resources), so no
# LD_LIBRARY_PATH or activation script is required — verified via `docker run --gpus all`.
CMD ["nninfe-det", "--help"]
