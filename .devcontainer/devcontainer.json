{
  "name": "nnInfe Dev (CPU)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libgomp1 && pip install -e .[cpu] pytest pytest-cov"
}
